{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    // `noUncheckedIndexedAccess` stays off here: svelte-check follows imports into the
    // linked design-system source, which is not ours to fix. Packages keep it on.
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022"
  }
}
