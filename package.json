{
	"name": "nib-ui",
	"devDependencies": {
		"@esbuild/linux-x64": "^0.28.2",
		"@rollup/rollup-linux-x64-gnu": "^4.62.5",
		"@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
		"@types/bun": "^1.4.0",
		"lightningcss-linux-x64-gnu": "^1.33.0",
		"typescript": "^5.9.3"
	},
	"private": true,
	"scripts": {
		"install:lean": "bun install --omit optional",
		"dev": "bun --filter @nib-ui/web dev",
		"build": "bun --filter @nib-ui/web build",
		"typecheck": "bun --filter '*' typecheck",
		"test": "bun test",
		"smoke": "bun apps/web/scripts/smoke.ts"
	},
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*",
		"plugins/*"
	]
}
